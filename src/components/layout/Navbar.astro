---
/**
 * Site navigation header.
 * Sticky top bar with company logo, primary links and CTA.
 */

import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Logo from '@components/shared/Logo.astro';

const links = [
  { label: 'Services', href: '/#services' },
  { label: 'How We Work', href: '/#methodology' },
  { label: 'Team', href: '/#team' },
] as const;
---

<header class="navbar">
  <Container class="navbar__inner">
    <Logo size="md" />

    <nav class="navbar__nav" aria-label="Primary">
      <ul class="navbar__list" role="list">
        {
          links.map((link) => (
            <li>
              <a class="navbar__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="navbar__actions">
      <Button href="/#contact" size="sm">Talk to us</Button>
    </div>
  </Container>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-white) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
  }

  .navbar :global(.container.navbar__inner),
  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4.5rem;
  }

  .navbar__nav {
    display: none;
  }

  .navbar__list {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
  }

  .navbar__link {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    transition: color var(--transition-fast);
  }

  .navbar__link:hover,
  .navbar__link:focus-visible {
    color: var(--color-primary-hover);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  @media (min-width: 768px) {
    .navbar__nav {
      display: block;
    }
  }
</style>
